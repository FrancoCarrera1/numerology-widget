# X API — OAuth 1.0a user context.
# Set app permissions to Read and Write BEFORE generating these tokens.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# OpenAI-compatible chat completions endpoint.
# The agent appends /chat/completions to this base URL.
# In GitHub Actions the workflow uses GitHub Models by default, so no LLM
# secret is needed there. Locally, use a provider key (Groq below) or a GitHub
# PAT with models:read and the GitHub Models base URL.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# Optional. YYYY-MM-DD adds Life Path and personal cycles; MM-DD adds personal
# cycles only. Leave unset for universal-only posts.
# BOT_BIRTHDAY=1990-05-23

# Calendar day used for "today".
BOT_TIMEZONE=America/Chicago

# Set to 1 to print stack traces on errors.
# DEBUG=1
